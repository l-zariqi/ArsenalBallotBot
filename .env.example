# --- Telegram bot (bot.py) ---
# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Discord bot (discord_bot.py) ---
# Get this from the Bot tab at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=YourDiscordBotTokenHere

# The calendar feed to watch (webcal:// is auto-converted to https://)
ICS_URL=webcal://ics.ecal.com/ecal-sub/6a8638216e26360002f4aadc/Arsenal%20FC.ics

# How often to poll the feed, in minutes
POLL_INTERVAL_MINUTES=15

# Send a reminder this many hours before a matched event starts
REMINDER_HOURS_BEFORE=24

# Comma-separated, case-insensitive substrings matched against each event's
# title + description to decide if it's ballot/registration-related
ALERT_KEYWORDS=ballot,registration,register,priority point,members sale,general sale,ticket sale,membership window

# Where to keep the SQLite database file
DB_PATH=bot_data.sqlite3

# Link included in each alert. Used when the calendar event itself has no
# URL attached (most ECAL entries don't) - point it wherever people should
# go to actually enter the ballot / see more details.
FALLBACK_URL=https://www.arsenal.com/tickets
